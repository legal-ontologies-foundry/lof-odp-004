    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000008"/>
    


    <!-- https://w3id.org/lof/ODP001_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001000"/>
    


    <!-- https://w3id.org/lof/ODP001_0001001 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001001"/>
    


    <!-- https://w3id.org/lof/ODP002_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP002_0001000"/>
    


    <!-- https://w3id.org/lof/ODP003_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001000"/>
    


    <!-- https://w3id.org/lof/ODP003_0001005 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001005"/>
    


    <!-- https://w3id.org/lof/ODP003_0001009 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001009"/>
    


    <!-- https://w3id.org/lof/ODP004_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP004_0001000">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lof/ODP003_0001005"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001103"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/lof/ODP001_0001000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP001_0001100"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Occupies MLC node 1 (source of authority). Grounded as a power per LOF-ODP-003; its BFO category follows the ODP-003 placement decision.</rdfs:comment>
        <rdfs:label xml:lang="en">norm-establishing power</rdfs:label>
        <skos:definition xml:lang="en">A power that is exercised in some legal act that establishes legal content.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP004_0001001 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP004_0001001">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000003"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="https://w3id.org/lof/ODP004_0001102"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Occupies MLC node 4 (triggering facts). Grounded as occurrent because what is legally operative is a change (a signing, a death, the start or end of a period), including the process boundary at which a standing state begins, rather than the state itself.</rdfs:comment>
        <rdfs:label xml:lang="en">triggering occurrence</rdfs:label>
        <skos:definition xml:lang="en">An occurrent that satisfies a condition, set out in legal content, for some legal position to come into existence.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP004_0001002 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP004_0001002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lof/ODP003_0001000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP004_0001104"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">Occupies MLC node 8 (remedy). A remedy is modeled as a further legal position (a claim to damages, a power to terminate, a duty to comply with an injunction), so the remedy node is itself a chain.</rdfs:comment>
        <rdfs:label xml:lang="en">remedial position</rdfs:label>
        <skos:definition xml:lang="en">A legal position that exists because some other legal position was not discharged, and whose discharge or exercise is directed to making good that failure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP004_0001003 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP004_0001003">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/lof/ODP003_0001000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001101"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/lof/ODP001_0001001"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP001_0001101"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/lof/ODP001_0001000"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty>
                                                            <rdf:Description>
                                                                <owl:inverseOf rdf:resource="https://w3id.org/lof/ODP003_0001103"/>
                                                            </rdf:Description>
                                                        </owl:onProperty>
                                                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001005"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP004_0001100"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/lof/ODP001_0001000"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP002_0001000"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP004_0001102"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP004_0001103"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/lof/ODP004_0001105"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:comment xml:lang="en">The chain-closure class. An individual is classified here only when every MLC node is occupied. Under the open-world assumption the reasoner cannot infer that a chain is incomplete; incompleteness is detected by the SHACL shapes in src/shapes.</rdfs:comment>
        <rdfs:label xml:lang="en">fully grounded legal position</rdfs:label>
        <skos:definition xml:lang="en">A legal position that is grounded in legal content established by a legal act in which some power was exercised, that is triggered by some occurrent, that is generated by a legal act realizing some legal role, that is directed at some entity, and for whose non-discharge some legal content provides a remedy.</skos:definition>
    </owl:Class>
</rdf:RDF>



