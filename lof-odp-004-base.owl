<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lof/odp-004/lof-odp-004-base.owl#"
     xml:base="https://w3id.org/lof/odp-004/lof-odp-004-base.owl"
     xmlns:lof="https://w3id.org/lof/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lof/odp-004/lof-odp-004-base.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/lof/odp-004/releases/0.1.0/lof-odp-004-base.owl"/>
        <dcterms:creator>David R. Koepsell</dcterms:creator>
        <dcterms:description xml:lang="en">DRAFT for review by the LOF founding coordinators. An ontology design pattern connecting the authority, norm, role, trigger, act, target, effect, and remedy through which a legal position comes to exist, with a defined class for positions whose chain is complete. Adapted from the Minimum Legal Chain of A Structural Ontology of the Law (Koepsell, Palgrave, forthcoming).</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">LOF-ODP-004: Minimum Legal Chain</dcterms:title>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


