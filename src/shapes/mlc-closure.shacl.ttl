@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix lof: <https://w3id.org/lof/> .
@prefix mlc: <https://w3id.org/lof/odp-004/shapes#> .

# LOF-ODP-004 chain-closure shapes. Run against a REASONED data graph
# (inferred types and inferred 'directed at' must be present).
# Each first-order legal position is checked node by node. A node counts as
# occupied if it is recorded on the position itself or on its correlative.
# Violation messages name the MLC node and cluster, so reports can be
# aggregated by node (the input to the SOoL contradiction typology).

mlc:FirstOrderPositionChain a sh:NodeShape ;
  sh:targetClass lof:ODP003_0001009 ;

  sh:property [ sh:name "node 1" ;
    sh:path [ sh:alternativePath (
      ( lof:ODP003_0001101 lof:ODP001_0001101 [ sh:inversePath lof:ODP003_0001103 ] )
      ( lof:ODP003_0001102 lof:ODP003_0001101 lof:ODP001_0001101 [ sh:inversePath lof:ODP003_0001103 ] ) ) ] ;
    sh:minCount 1 ;
    sh:message "MLC node 1 (AUTHORITY): the grounding legal content was not established by a legal act in which any power was exercised." ] ;

  sh:property [ sh:name "node 2" ;
    sh:path lof:ODP003_0001101 ; sh:class lof:ODP001_0001001 ; sh:minCount 1 ;
    sh:message "MLC node 2 (AUTHORITY): no grounding legal content." ] ;

  sh:property [ sh:name "node 3" ;
    sh:path [ sh:alternativePath (
      ( lof:ODP004_0001100 obo:BFO_0000055 )
      ( lof:ODP003_0001102 lof:ODP004_0001100 obo:BFO_0000055 ) ) ] ;
    sh:class lof:ODP002_0001000 ; sh:minCount 1 ; sh:severity sh:Warning ;
    sh:message "MLC node 3 (AUTHORITY): not generated by an act realizing a legal role (operation of law, or missing actor). See ODP-004 open question 2." ] ;

  sh:property [ sh:name "node 4" ;
    sh:path [ sh:alternativePath ( lof:ODP004_0001102 ( lof:ODP003_0001102 lof:ODP004_0001102 ) ) ] ;
    sh:minCount 1 ;
    sh:message "MLC node 4 (EFFECT): no triggering occurrence." ] ;

  sh:property [ sh:name "node 5" ;
    sh:path [ sh:alternativePath ( lof:ODP004_0001100 ( lof:ODP003_0001102 lof:ODP004_0001100 ) ) ] ;
    sh:minCount 1 ;
    sh:message "MLC node 5 (EFFECT): no generating act or occurrence." ] ;

  sh:property [ sh:name "node 6" ;
    sh:path lof:ODP004_0001103 ; sh:minCount 1 ;
    sh:message "MLC node 6 (RECOGNITION): not directed at any entity (no correlative holder and no asserted target)." ] ;

  sh:property [ sh:name "node 8" ;
    sh:path [ sh:alternativePath ( lof:ODP004_0001105 ( lof:ODP003_0001102 lof:ODP004_0001105 ) ) ] ;
    sh:class lof:ODP001_0001001 ; sh:minCount 1 ;
    sh:message "MLC node 8 (REPAIR): no legal content provides a remedy for non-discharge." ] .
# Node 7 (legal effect) is the focus node itself.
