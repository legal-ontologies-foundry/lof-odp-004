    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://w3id.org/lof/ODP003_0001100 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001100">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">In Option B this is not a subproperty of inherence; a legal position is related to its holder without inhering in it.</rdfs:comment>
        <rdfs:label xml:lang="en">held by</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal position and the person or organization whose position it is.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001101 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001101">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:label xml:lang="en">grounded in</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal position and the legal content in virtue of which it exists, such as the contract term creating a duty to pay.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001102 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001102">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:label xml:lang="en">correlative of</rdfs:label>
        <skos:definition xml:lang="en">A symmetric relation between two legal positions held by different parties, each of which exists if and only if the other does, such as a claim and the duty owed in satisfaction of it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001103 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001103">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001005"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:label xml:lang="en">exercised in</rdfs:label>
        <skos:definition xml:lang="en">A relation between a power and a legal act through which the holder of the power changes the legal positions of another party.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
    


    <!-- https://w3id.org/lof/ODP001_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001000"/>
    


    <!-- https://w3id.org/lof/ODP001_0001001 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001001"/>
    


    <!-- https://w3id.org/lof/ODP003_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001100"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001101"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">BFO placement, OPTION B (LOF-P-004): a legal position is a generically dependent continuant, like the legal content that grounds it. It is related to its holder by &apos;held by&apos; rather than by inherence, so the same position can survive a change of holder (assignment of a claim, succession to a debt on death). OPEN QUESTION for the founding coordinators; see Option A.</rdfs:comment>
        <rdfs:label xml:lang="en">legal position</rdfs:label>
        <skos:altLabel xml:lang="en">Hohfeldian position</skos:altLabel>
        <skos:definition xml:lang="en">A continuant that is held by a person or organization in virtue of some legal content, and that consists in what the holder is legally required, permitted, or enabled to do, or protected from having done to them, in relation to some other party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001001 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">claim</rdfs:label>
        <skos:altLabel xml:lang="en">right</skos:altLabel>
        <skos:definition xml:lang="en">A first-order legal position in virtue of which its holder is owed some conduct by another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001002 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">duty</rdfs:label>
        <skos:definition xml:lang="en">A first-order legal position in virtue of which its holder is required to engage in, or refrain from, some conduct owed to another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001003 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">liberty</rdfs:label>
        <skos:altLabel xml:lang="en">privilege</skos:altLabel>
        <skos:definition xml:lang="en">A first-order legal position in virtue of which its holder is not under a duty to another party to refrain from some conduct.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001004 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001009"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">no-claim</rdfs:label>
        <skos:altLabel xml:lang="en">no-right</skos:altLabel>
        <skos:definition xml:lang="en">A first-order legal position in virtue of which its holder has no claim against another party with respect to some conduct of that party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001005 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">power</rdfs:label>
        <skos:definition xml:lang="en">A second-order legal position in virtue of which its holder can, by some legal act, change the legal positions of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001006 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">liability</rdfs:label>
        <skos:definition xml:lang="en">A second-order legal position in virtue of which its holder&apos;s legal positions can be changed by some legal act of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001007 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">immunity</rdfs:label>
        <skos:definition xml:lang="en">A second-order legal position in virtue of which its holder&apos;s legal positions cannot be changed by some legal act of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001008 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001010"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP003_0001102"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/lof/ODP003_0001007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">disability</rdfs:label>
        <skos:definition xml:lang="en">A second-order legal position in virtue of which its holder cannot, by some legal act, change the legal positions of another party.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001009 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <owl:disjointWith rdf:resource="https://w3id.org/lof/ODP003_0001010"/>
        <rdfs:label xml:lang="en">first-order legal position</rdfs:label>
        <skos:definition xml:lang="en">A legal position that concerns what its holder or another party is required or permitted to do.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP003_0001010 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP003_0001010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:label xml:lang="en">second-order legal position</rdfs:label>
        <skos:definition xml:lang="en">A legal position that concerns whether its holder or another party can change first-order or second-order legal positions.</skos:definition>
    </owl:Class>
    


