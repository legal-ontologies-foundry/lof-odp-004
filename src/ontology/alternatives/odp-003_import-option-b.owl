<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lof/odp-004/imports/odp-003_import.owl#"
     xml:base="https://w3id.org/lof/odp-004/imports/odp-003_import.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:odp1="https://w3id.org/lof/ODP001_"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lof/odp-004/imports/odp-003_import.owl">
        <dcterms:creator>David R. Koepsell</dcterms:creator>
        <dcterms:description xml:lang="en">LOF-ODP-003, Option B: legal positions placed under generically dependent continuant. Identical to Option A except for the placement of legal position and the character of &apos;held by&apos;. DRAFT.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">LOF-ODP-003: Correlative Deontic Positions</dcterms:title>
    </owl:Ontology>
    


