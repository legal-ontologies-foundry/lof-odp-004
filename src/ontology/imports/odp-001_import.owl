    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#example"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000057 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000057"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000101 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000101"/>
    


    <!-- https://w3id.org/lof/ODP001_0001100 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP001_0001100">
        <owl:inverseOf rdf:resource="https://w3id.org/lof/ODP001_0001101"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:label xml:lang="en">establishes</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal act and the legal content that comes into being through that act.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP001_0001101 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP001_0001101">
        <rdfs:label xml:lang="en">established by</rdfs:label>
        <skos:definition xml:lang="en">A relation between legal content and the legal act through which it came into being.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP001_0001102 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP001_0001102">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:label xml:lang="en">performed under</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal act and pre-existing legal content that authorizes or governs it, such as an enabling statute or a rule of procedure.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP001_0001103 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP001_0001103">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001002"/>
        <rdfs:comment xml:lang="en">Documents do not act; persons and organizations do. A document related by this relation is an operative (dispositive) instrument: the law makes the writing part of how the act is done. Contrast evidences, which holds of documents that merely record or attest to an act.</rdfs:comment>
        <rdfs:label xml:lang="en">performed by means of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal act and a legal document that participates in it as the instrument through which the act is performed, as when a deed is executed or a statutory form is signed before witnesses.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP001_0001104 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP001_0001104">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">Evidencing is not participation: the evidencing entity may come into existence after the act, and the act may occur with no document at all. Nothing about an act, role, or position may be inferred from the existence of an evidencing document alone. An instrument usually also evidences the act performed by means of it, so the two relations are not disjoint.</rdfs:comment>
        <rdfs:label xml:lang="en">evidences</rdfs:label>
        <skos:definition xml:lang="en">A relation between a material entity, such as a legal document, and a legal act, legal content, or other entity whose existence or occurrence it records or attests to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000031"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000040 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
    


    <!-- https://w3id.org/lof/ODP001_0001000 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000057"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">BFO placement (LOF-P-004): a legal act unfolds in time and has temporal parts (offer and acceptance, the stages of a legislative vote), so it is a process. It is distinguished from the content it establishes, which outlives it.</rdfs:comment>
        <rdfs:label xml:lang="en">legal act</rdfs:label>
        <skos:definition xml:lang="en">A process, having one or more persons or organizations as participants, that a legal system recognizes as bringing into being, modifying, or terminating legally significant entities.</skos:definition>
        <skos:example xml:lang="en">the signing of a residential lease; the enactment of a statute; the delivery of a judgment</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001001 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <rdfs:comment xml:lang="en">A single body of legal content, such as a statute, typically has legal norms, legal definitions, and legal designators among its parts (BFO &apos;has continuant part&apos;). It is therefore not itself a norm, a definition, or a designator as a whole.</rdfs:comment>
        <rdfs:comment xml:lang="en">BFO placement (LOF-P-004): the same statute or contract term can be concretized in many copies and survives the destruction of any one of them. That is the mark of a generically dependent continuant. Legal content corresponds to the Work and Expression levels in FRBR-based legal standards.</rdfs:comment>
        <rdfs:label xml:lang="en">legal content</rdfs:label>
        <skos:altLabel xml:lang="en">legal information content</skos:altLabel>
        <skos:closeMatch rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <skos:definition xml:lang="en">A generically dependent continuant that is established by some legal act and that specifies legally significant entities, such as the provisions of a statute, the terms of a contract, or the holding of a judgment.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001002 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000101"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">BFO placement (LOF-P-004): the particular signed paper, or the particular stored file, is a material entity that carries the content. Digital documents are treated as patterns in material storage media. Note that IAO&apos;s &apos;document&apos; is an information content entity, so it corresponds to legal content here, not to legal document. Legal document corresponds to the Item level in FRBR-based legal standards. A legal document takes part in a legal act only as its instrument (performed by means of); otherwise it at most evidences the act (evidences).</rdfs:comment>
        <rdfs:label xml:lang="en">legal document</rdfs:label>
        <skos:definition xml:lang="en">A material entity that is the carrier of some legal content.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001003 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP001_0001100"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/lof/ODP001_0001004"/>
        <rdfs:label xml:lang="en">enactment</rdfs:label>
        <skos:definition xml:lang="en">A legal act in which a body with legislative authority establishes legal content of general application.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001004 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/lof/ODP001_0001100"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">contract formation</rdfs:label>
        <skos:definition xml:lang="en">A legal act in which two or more parties establish legal content that binds them to one another.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001005 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:comment xml:lang="en">The operative provisions of a statute, regulation, contract, or judgment. Legal positions (LOF-ODP-003) are grounded in legal norms. Corresponds to CCO &apos;process regulation&apos; and its three kinds (process requirement, process prohibition, action permission); see the LOF to CCO bridge.</rdfs:comment>
        <rdfs:label xml:lang="en">legal norm</rdfs:label>
        <skos:definition xml:lang="en">Legal content that requires, prohibits, or permits some kind of conduct.</skos:definition>
        <skos:example xml:lang="en">a lease clause requiring rent to be paid by the first of the month; a statute prohibiting resuscitation of a person with a valid DNR order</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001006 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:comment xml:lang="en">Corresponds to CCO &apos;descriptive information content entity&apos;.</rdfs:comment>
        <rdfs:label xml:lang="en">legal definition</rdfs:label>
        <skos:definition xml:lang="en">Legal content that states what a term means for the purposes of some other legal content.</skos:definition>
        <skos:example xml:lang="en">the definitions section of a statute</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/lof/ODP001_0001007 -->

    <owl:Class rdf:about="https://w3id.org/lof/ODP001_0001007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:comment xml:lang="en">Corresponds to CCO &apos;designative information content entity&apos;. The natural point of attachment for identifier standards such as Akoma Ntoso eIds and ELI.</rdfs:comment>
        <rdfs:label xml:lang="en">legal designator</rdfs:label>
        <skos:definition xml:lang="en">Legal content that names or identifies some legal content or legal document, such as a title, a section number, or a citation.</skos:definition>
        <skos:example xml:lang="en">&apos;8 U.S.C. 1103(a)(3)&apos;; the short title of an act</skos:example>
    </owl:Class>
</rdf:RDF>



