@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix lof: <https://w3id.org/lof/> .

<https://w3id.org/lof/odp-001.owl> a owl:Ontology ;
  rdfs:comment "LOCAL STUB reconstructed from the published LOF-ODP-001 specification page, for building and testing LOF-ODP-004. Replace with the released odp-001.owl via the catalog once lof-odp-001 is public." ;
  owl:imports <https://w3id.org/lof/odp-004/imports/bfo_import.owl> .
lof:ODP001_0001000 a owl:Class ; rdfs:label "legal act"@en ;
  rdfs:subClassOf obo:BFO_0000015 , [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom obo:BFO_0000040 ] .
lof:ODP001_0001001 a owl:Class ; rdfs:label "legal content"@en ; rdfs:subClassOf obo:BFO_0000031 .
lof:ODP001_0001002 a owl:Class ; rdfs:label "legal document"@en ;
  rdfs:subClassOf obo:BFO_0000040 , [ a owl:Restriction ; owl:onProperty obo:BFO_0000101 ; owl:someValuesFrom lof:ODP001_0001001 ] .
lof:ODP001_0001003 a owl:Class ; rdfs:label "enactment"@en ;
  rdfs:subClassOf lof:ODP001_0001000 , [ a owl:Restriction ; owl:onProperty lof:ODP001_0001100 ; owl:someValuesFrom lof:ODP001_0001001 ] ;
  owl:disjointWith lof:ODP001_0001004 .
lof:ODP001_0001004 a owl:Class ; rdfs:label "contract formation"@en ;
  rdfs:subClassOf lof:ODP001_0001000 , [ a owl:Restriction ; owl:onProperty lof:ODP001_0001100 ; owl:someValuesFrom lof:ODP001_0001001 ] .
lof:ODP001_0001100 a owl:ObjectProperty ; rdfs:label "establishes"@en ; rdfs:domain lof:ODP001_0001000 ; rdfs:range lof:ODP001_0001001 .
lof:ODP001_0001101 a owl:ObjectProperty ; rdfs:label "established by"@en ; owl:inverseOf lof:ODP001_0001100 .
lof:ODP001_0001102 a owl:ObjectProperty ; rdfs:label "performed under"@en ; rdfs:domain lof:ODP001_0001000 ; rdfs:range lof:ODP001_0001001 .
