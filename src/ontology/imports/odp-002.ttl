lof:ODP002_0001003 a owl:Class ; rdfs:label "role termination act"@en ;
  owl:equivalentClass [ owl:intersectionOf ( lof:ODP001_0001000 [ a owl:Restriction ; owl:onProperty lof:ODP002_0001102 ; owl:someValuesFrom lof:ODP002_0001000 ] ) ] .
lof:ODP002_0001100 a owl:ObjectProperty ; rdfs:label "confers"@en ; rdfs:domain lof:ODP001_0001000 ; rdfs:range lof:ODP002_0001000 .
