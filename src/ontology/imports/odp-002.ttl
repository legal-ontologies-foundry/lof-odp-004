  rdfs:comment "LOCAL STUB reconstructed from the published LOF-ODP-002 specification page." ;
  owl:imports <https://w3id.org/lof/odp-001.owl> .
lof:ODP002_0001000 a owl:Class ; rdfs:label "legal role"@en ;
  rdfs:subClassOf obo:BFO_0000023 , [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom obo:BFO_0000040 ] .
