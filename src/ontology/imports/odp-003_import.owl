<?xml version="1.0"?>
<rdf:RDF xmlns="https://w3id.org/lof/odp-004/imports/odp-003_import.owl#"
     xml:base="https://w3id.org/lof/odp-004/imports/odp-003_import.owl"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:odp1="https://w3id.org/lof/ODP001_"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://w3id.org/lof/odp-004/imports/odp-003_import.owl">
        <owl:versionIRI rdf:resource="https://w3id.org/lof/odp-003/releases/0.2.0/lof-odp-003-base.owl"/>
        <dcterms:creator>David R. Koepsell</dcterms:creator>
        <dcterms:description xml:lang="en">Ontology design pattern for Hohfeld&apos;s correlative legal positions (claim and duty, liberty and no-claim, power and liability, immunity and disability), grounded in legal content from LOF-ODP-001. Legal positions are BFO roles inhering in their holders, aligned with the deontic roles of the Document Act Ontology (D-Acts). DRAFT.</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="en">LOF-ODP-003: Correlative Deontic Positions</dcterms:title>
        <owl:versionInfo>0.2.0</owl:versionInfo>
    </owl:Ontology>
    


