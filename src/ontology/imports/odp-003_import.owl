     -->

    


    <!-- http://purl.obolibrary.org/obo/BFO_0000054 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000054"/>
    


    <!-- http://purl.obolibrary.org/obo/BFO_0000197 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/BFO_0000197"/>
    


    <!-- https://w3id.org/lof/ODP003_0001100 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001100">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000197"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:comment xml:lang="en">A functional subproperty of BFO &apos;inheres in&apos;, reflecting the one-bearer axiom of ISO/IEC 21838-2. A position never has two holders; a change of holder is a new position that succeeds the old one.</rdfs:comment>
        <rdfs:label xml:lang="en">held by</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal position and the person or organization whose position it is.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001101 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001101">
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001001"/>
        <rdfs:label xml:lang="en">grounded in</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal position and the legal content in virtue of which it exists, such as the contract term creating a duty to pay.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001102 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001102">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:label xml:lang="en">correlative of</rdfs:label>
        <skos:definition xml:lang="en">A symmetric relation between two legal positions held by different parties, each of which exists if and only if the other does, such as a claim and the duty owed in satisfaction of it.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001103 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001103">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001005"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP001_0001000"/>
        <rdfs:comment xml:lang="en">A subproperty of BFO &apos;realized in&apos;: the legal act realizes the power exercised in it. This is the sense in which a role conferral act &apos;realizes&apos; something (W. Mandrick, ODP 2 slide): it realizes the conferring party&apos;s power, which corresponds to the D-Acts deontic declaration performer role, not the role it confers.</rdfs:comment>
        <rdfs:label xml:lang="en">exercised in</rdfs:label>
        <skos:definition xml:lang="en">A relation between a power and a legal act through which the holder of the power changes the legal positions of another party.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/lof/ODP003_0001104 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/lof/ODP003_0001104">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#IrreflexiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:range rdf:resource="https://w3id.org/lof/ODP003_0001000"/>
        <rdfs:comment xml:lang="en">Lets a query follow &apos;the same claim&apos; through changes of holder, which Option B had obtained by making positions generically dependent, without giving up the one-bearer axiom.</rdfs:comment>
        <rdfs:label xml:lang="en">succeeds</rdfs:label>
        <skos:definition xml:lang="en">A relation between a legal position and an earlier legal position, held by another party, whose place it takes in the same legal relation through an assignment, a succession, or a transfer of office.</skos:definition>
        <skos:example xml:lang="en">a collection agency&apos;s claim to rent, acquired by assignment, succeeds the landlord&apos;s claim; an incoming commander&apos;s authority to issue orders succeeds the outgoing commander&apos;s</skos:example>
    </owl:ObjectProperty>
    


