@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix lof: <https://w3id.org/lof/> .

<https://w3id.org/lof/odp-004.owl> a owl:Ontology ;
  owl:versionIRI <https://w3id.org/lof/odp-004/releases/0.1.0/odp-004.owl> ;
  owl:versionInfo "0.1.0" ;
  dcterms:title "LOF-ODP-004: Minimum Legal Chain"@en ;
  dcterms:description "DRAFT for review by the LOF founding coordinators. An ontology design pattern connecting the authority, norm, role, trigger, act, target, effect, and remedy through which a legal position comes to exist, with a defined class for positions whose chain is complete. Adapted from the Minimum Legal Chain of A Structural Ontology of the Law (Koepsell, Palgrave, forthcoming)."@en ;
  dcterms:creator "David R. Koepsell" ;
  dcterms:license <https://creativecommons.org/licenses/by/4.0/> ;
  owl:imports <https://w3id.org/lof/odp-004/imports/bfo_import.owl> ,
    <https://w3id.org/lof/odp-004/imports/odp-001_import.owl> ,
    <https://w3id.org/lof/odp-004/imports/odp-002_import.owl> ,
    <https://w3id.org/lof/odp-004/imports/odp-003_import.owl> .


##### Classes #####

lof:ODP004_0001000 a owl:Class ;
  rdfs:label "norm-establishing power"@en ;
  skos:definition "A power that is exercised in some legal act that establishes legal content."@en ;
  rdfs:comment "Occupies MLC node 1 (source of authority). Grounded as a power per LOF-ODP-003; its BFO category follows the ODP-003 placement decision."@en ;
  owl:equivalentClass [ owl:intersectionOf ( lof:ODP003_0001005
      [ a owl:Restriction ; owl:onProperty lof:ODP003_0001103 ;
        owl:someValuesFrom [ owl:intersectionOf ( lof:ODP001_0001000
          [ a owl:Restriction ; owl:onProperty lof:ODP001_0001100 ; owl:someValuesFrom lof:ODP001_0001001 ] ) ] ] ) ] .

lof:ODP004_0001001 a owl:Class ;
  rdfs:label "triggering occurrence"@en ;
  skos:definition "An occurrent that satisfies a condition, set out in legal content, for some legal position to come into existence."@en ;
  rdfs:comment "Occupies MLC node 4 (triggering facts). Grounded as occurrent because what is legally operative is a change (a signing, a death, the start or end of a period), including the process boundary at which a standing state begins, rather than the state itself."@en ;
  owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000003
      [ a owl:Restriction ; owl:onProperty [ owl:inverseOf lof:ODP004_0001102 ] ; owl:someValuesFrom lof:ODP003_0001000 ] ) ] .

lof:ODP004_0001002 a owl:Class ;
  rdfs:label "remedial position"@en ;
  skos:definition "A legal position that exists because some other legal position was not discharged, and whose discharge or exercise is directed to making good that failure."@en ;
  rdfs:comment "Occupies MLC node 8 (remedy). A remedy is modeled as a further legal position (a claim to damages, a power to terminate, a duty to comply with an injunction), so the remedy node is itself a chain."@en ;
  owl:equivalentClass [ owl:intersectionOf ( lof:ODP003_0001000
      [ a owl:Restriction ; owl:onProperty lof:ODP004_0001104 ; owl:someValuesFrom lof:ODP003_0001000 ] ) ] .

lof:ODP004_0001003 a owl:Class ;
  rdfs:label "fully grounded legal position"@en ;
  skos:definition "A legal position that is grounded in legal content established by a legal act in which some power was exercised, that is triggered by some occurrent, that is generated by a legal act realizing some legal role, that is directed at some entity, and for whose non-discharge some legal content provides a remedy."@en ;
  rdfs:comment "The chain-closure class. An individual is classified here only when every MLC node is occupied. Under the open-world assumption the reasoner cannot infer that a chain is incomplete; incompleteness is detected by the SHACL shapes in src/shapes."@en ;
  owl:equivalentClass [ owl:intersectionOf ( lof:ODP003_0001000
      [ a owl:Restriction ; owl:onProperty lof:ODP003_0001101 ;
        owl:someValuesFrom [ owl:intersectionOf ( lof:ODP001_0001001
          [ a owl:Restriction ; owl:onProperty lof:ODP001_0001101 ;
            owl:someValuesFrom [ owl:intersectionOf ( lof:ODP001_0001000
              [ a owl:Restriction ; owl:onProperty [ owl:inverseOf lof:ODP003_0001103 ] ; owl:someValuesFrom lof:ODP003_0001005 ] ) ] ] ) ] ]
      [ a owl:Restriction ; owl:onProperty lof:ODP004_0001102 ; owl:someValuesFrom obo:BFO_0000003 ]
      [ a owl:Restriction ; owl:onProperty lof:ODP004_0001100 ;
        owl:someValuesFrom [ owl:intersectionOf ( lof:ODP001_0001000
          [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom lof:ODP002_0001000 ] ) ] ]
      [ a owl:Restriction ; owl:onProperty lof:ODP004_0001103 ; owl:someValuesFrom obo:BFO_0000001 ]
      [ a owl:Restriction ; owl:onProperty lof:ODP004_0001105 ; owl:someValuesFrom lof:ODP001_0001001 ] ) ] .

##### Relations #####

lof:ODP004_0001100 a owl:ObjectProperty ;
  rdfs:label "generated by"@en ;
  skos:definition "A relation between a legal position and an occurrent through which the position comes into existence."@en ;
  rdfs:comment "Links MLC node 7 (legal effect) to node 5 (legal act). Its range is occurrent rather than legal act so that positions arising by operation of law can be represented."@en ;
  rdfs:domain lof:ODP003_0001000 ; rdfs:range obo:BFO_0000003 .

lof:ODP004_0001101 a owl:ObjectProperty ;
  rdfs:label "generates"@en ;
  skos:definition "A relation between an occurrent and a legal position that comes into existence through it."@en ;
  owl:inverseOf lof:ODP004_0001100 .

lof:ODP004_0001102 a owl:ObjectProperty ;
  rdfs:label "triggered by"@en ;
  skos:definition "A relation between a legal position and an occurrent that satisfies a condition, set out in the legal content in which the position is grounded, for the position to come into existence."@en ;
  rdfs:domain lof:ODP003_0001000 ; rdfs:range obo:BFO_0000003 .

lof:ODP004_0001103 a owl:ObjectProperty ;
  rdfs:label "directed at"@en ;
  skos:definition "A relation between a legal position and an entity toward which the position is oriented, either the holder of its correlative position or a thing over which the position obtains."@en ;
  rdfs:comment "Occupies MLC node 6 (target). Inferred for party targets by the chain: correlative of o held by. Asserted directly for thing targets (the land, the patented invention, the data set)."@en ;
  rdfs:domain lof:ODP003_0001000 ;
  owl:propertyChainAxiom ( lof:ODP003_0001102 lof:ODP003_0001100 ) .

lof:ODP004_0001104 a owl:ObjectProperty ;
  rdfs:label "remedies"@en ;
  skos:definition "A relation between a legal position and another legal position, whose non-discharge is the occasion of the first and whose discharge or exercise is directed to making good that non-discharge."@en ;
  rdfs:domain lof:ODP003_0001000 ; rdfs:range lof:ODP003_0001000 .

lof:ODP004_0001105 a owl:ObjectProperty ;
  rdfs:label "remedy provided by"@en ;
  skos:definition "A relation between a legal position and legal content that specifies which remedial positions arise if the position is not discharged."@en ;
  rdfs:domain lof:ODP003_0001000 ; rdfs:range lof:ODP001_0001001 .

lof:ODP004_0001106 a owl:ObjectProperty ;
  rdfs:label "undischarged during"@en ;
  skos:definition "A relation between a first-order legal position and a temporal region during which no process occurs that complies with the position."@en ;
  rdfs:comment "Represents omission without reifying non-events: the omission is the asserted non-discharge of a position over a temporal region, and the end of that region is typically the triggering occurrence of a remedial position. Proposal for review."@en ;
  rdfs:domain lof:ODP003_0001009 ; rdfs:range obo:BFO_0000008 .
