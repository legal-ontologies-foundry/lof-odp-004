# ID ranges for ODP004 term IRIs (LOF identifier policy).
# 0000001-0000999 reserved; 0001000-0001999 first editor.

Ontology(<https://w3id.org/lof/odp-004/lof-odp-004-idranges.owl>
Annotation(idsfor: "ODP004")
Annotation(idprefix: "https://w3id.org/lof/ODP004_")
Annotation(iddigits: 7)

Datatype(idrange:1)
AnnotationAssertion(allocatedto: idrange:1 "David R. Koepsell")
DatatypeDefinition(idrange:1 DatatypeRestriction(xsd:integer xsd:minInclusive "1000"^^xsd:integer xsd:maxInclusive "1999"^^xsd:integer))
)
