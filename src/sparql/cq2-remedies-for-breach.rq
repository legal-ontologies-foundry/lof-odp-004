# CQ2. Which positions were not discharged, during what period, and what
# remedial positions arose in consequence, triggered by what?
PREFIX lof: <https://w3id.org/lof/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?breached ?period ?remedial ?holder ?trigger WHERE {
  ?b lof:ODP004_0001106 ?t ; rdfs:label ?breached . ?t rdfs:label ?period .
  OPTIONAL { ?r lof:ODP004_0001104 ?b ; rdfs:label ?remedial ;
             lof:ODP003_0001100/rdfs:label ?holder .
             OPTIONAL { ?r lof:ODP004_0001102/rdfs:label ?trigger } }
}
